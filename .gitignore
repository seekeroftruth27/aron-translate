# Python
__pycache__/
*.py[cod]
.venv/
venv/
.venv-win/

# Audio media — input samples and generated clips kept out of git by default.
# (May be large or contain private recordings. Force-add a fixture if you want it tracked.)
*.wav
*.m4a
*.mp3
*.flac
*.ogg
*.webm

# Saved services: the recorder writes audio.mp3 + captions + transcript per
# service here (CT_RECORD_DIR moves it). Private by definition -- never commit.
recordings/

# Logs / scratch
*.log

# Stress-battery output in the working directory (regenerated by each run).
# A run worth keeping goes under validation/results/<date>-.../ and is committed.
*_results.json
!validation/results/**/*_results.json

# PyInstaller build artifacts
build/
dist/

# Local secrets (API keys). Never commit. Use .env.example as the template.
.env

# Web caption relay: the real token config and the live caption store are per-
# deployment and never committed. Use config.sample.php as the template.
web/captions/config.php
web/captions/captions.json

# Claude Code machine-local settings (permissions etc.)
.claude/settings.local.json
earned_*.tsv

